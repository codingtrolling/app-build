<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.codingtrolling.hub">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:label="CodingTrolling"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".tools.AndroidLinkActivity" />
        <activity android:name=".tools.BozinAiActivity" />
        <activity android:name=".tools.VmMatrixActivity" />
        <activity android:name=".tools.PannyPaintingActivity" />
        <activity android:name=".tools.PdfReaderActivity" />
        <activity android:name=".tools.MediaReaderActivity" />

    </application>
</manifest>
