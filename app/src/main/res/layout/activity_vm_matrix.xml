<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:padding="16dp">

    <TextView
        android:id="@+id/vm_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ VIRTUAL MATRIX ]"
        android:textColor="#FF00FF"
        android:textSize="20sp"
        android:layout_centerHorizontal="true"
        android:fontFamily="monospace" />

    <ScrollView
        android:id="@+id/scroll_vm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/vm_title"
        android:layout_above="@id/btn_boot_vm"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="#111111">
        
        <TextView
            android:id="@+id/txt_vm_console"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00FF00"
            android:padding="10dp"
            android:fontFamily="monospace" />
    </ScrollView>

    <Button
        android:id="@+id/btn_boot_vm"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_above="@id/btn_vm_back"
        android:text="BOOT VIRTUAL_SYSTEM"
        android:backgroundTint="#FF00FF"
        android:textColor="#000000" />

    <Button
        android:id="@+id/btn_vm_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="TERMINATE_VM"
        android:backgroundTint="#333333" />

</RelativeLayout>
