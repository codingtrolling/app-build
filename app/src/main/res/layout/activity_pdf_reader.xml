<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">
    <ImageView android:id="@+id/pdf_view" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@id/txt_pdf_status" />
    <TextView android:id="@+id/txt_pdf_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:textColor="#00FF00" android:background="#1A1A1A" android:padding="10dp" android:fontFamily="monospace" />
</RelativeLayout>
